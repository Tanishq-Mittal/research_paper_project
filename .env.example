# ScholarPulse Environment Configuration Example

# Security & Tokens
SECRET_KEY=scholarpulse-super-secret-jwt-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default for zero-setup local dev; or PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./scholarpulse.db
# DATABASE_URL=postgresql+asyncpg://scholar_user:secure_password@localhost:5432/scholarpulse_db

# Optional AI API Keys (System works seamlessly with deterministic fallback if left empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# RAG & Embedding Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_TYPE=in_memory_chroma
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MAX_UPLOAD_SIZE_MB=25
